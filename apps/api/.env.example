# Database connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_saas

# JWT signing secret (required in production; generate with: openssl rand -hex 32)
# Without it, a random per-boot secret is used and tokens do not survive a restart.
JWT_SECRET=

# Logging level (optional, default: info)
# Options: error, warn, info, debug
LOG_LEVEL=info

# Server port (optional, default: 3001)
PORT=3001
